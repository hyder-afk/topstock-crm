{
  "name": "topstock-crm",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start -p 3100",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "check:native": "node scripts/check-native-controls.mjs",
    "test:e2e": "playwright test",
    "test:unit": "playwright test -c playwright.unit.config.ts",
    "prepare": "simple-git-hooks",
    "verify": "npm run lint && npm run typecheck && npm run check:native && npm run test:unit && npm run build && npm run test:e2e",
    "test:db": "bash scripts/db-test.sh"
  },
  "dependencies": {
    "@dnd-kit/core": "6.3.1",
    "@radix-ui/react-context-menu": "2.3.7",
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-dropdown-menu": "2.1.24",
    "@radix-ui/react-popover": "1.1.23",
    "@radix-ui/react-select": "2.3.7",
    "@radix-ui/react-tooltip": "1.2.16",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.117.3",
    "@tanstack/react-query": "5.103.2",
    "@tanstack/react-table": "9.2.4",
    "@tanstack/react-virtual": "3.14.13",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "lucide-react": "1.54.0",
    "motion": "14.0.0",
    "next": "16.4.1",
    "next-intl": "4.14.9",
    "next-themes": "0.4.6",
    "papaparse": "5.7.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "22.20.5",
    "@types/papaparse": "5.5.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.1",
    "simple-git-hooks": "2.14.0",
    "supabase": "2.120.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3"
  },
  "simple-git-hooks": {
    "pre-commit": "npm run lint && npm run typecheck"
  },
  "engines": {
    "node": "22.x"
  }
